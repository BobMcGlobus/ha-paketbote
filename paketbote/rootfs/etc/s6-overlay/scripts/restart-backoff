#!/command/with-contenv bashio
# ==============================================================================
# Shared s6 finish handler for services that are worth restarting rather than
# fatal. The pause stops a persistent failure from turning into a hot loop.
#
# Usage: restart-backoff <service-name> <exit-code> <signal>
# ==============================================================================
declare -r service="${1}"
declare -r exit_code="${2}"
declare -r exit_signal="${3}"

# Exit code 256 means "killed by a signal"; SIGTERM is s6 shutting the add-on
# down, not a failure. Announcing a restart there is both wrong and slow.
if [[ "${exit_code}" -eq 256 ]] && [[ "${exit_signal}" -eq 15 ]]; then
    bashio::log.debug "Service ${service} stopped on shutdown"
    exit 0
fi

bashio::log.warning "Service ${service} exited with code ${exit_code} (signal ${exit_signal})"

sleep 1
