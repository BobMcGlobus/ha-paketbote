#!/command/with-contenv bashio
# ==============================================================================
# Bridges the VNC socket to a websocket and serves the noVNC client.
# ==============================================================================
bashio::log.info "Starting noVNC on 127.0.0.1:6081..."

exec websockify \
    --web=/usr/share/novnc \
    127.0.0.1:6081 \
    127.0.0.1:5900
