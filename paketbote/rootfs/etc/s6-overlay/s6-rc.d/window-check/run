#!/command/with-contenv bashio
# ==============================================================================
# Report whether the browser is actually visible in the panel, and nudge it if
# it is not quite right.
#
# Chrome can be perfectly alive — the scraper talks to it over CDP — while its
# window never shows up on the X server. This says which of the two it is.
#
# bashio runs scripts under errexit/pipefail, and a failed s6 oneshot takes the
# whole container down. Diagnostics must never be able to do that, so this one
# opts out and always exits 0.
# ==============================================================================
set +o errexit
set +o pipefail
set +o nounset

declare -i attempt
declare window=""
declare dimensions=""

bashio::log.info "Waiting for the browser window on ${DISPLAY}..."

for attempt in $(seq 1 30); do
    window="$(xdotool search --onlyvisible --class chrome 2>/dev/null | head -n1)"
    if [[ -n "${window}" ]]; then
        break
    fi
    sleep 2
done

dimensions="$(xdpyinfo -display "${DISPLAY}" 2>/dev/null | awk '/dimensions:/ {print $2}')"
bashio::log.info "Screen is ${dimensions:-unknown}"

if [[ -z "${window}" ]]; then
    # A window that exists but is not visible and one that was never created
    # are different faults, so say which it is.
    declare hidden=""
    hidden="$(xdotool search --class chrome 2>/dev/null | tr '\n' ' ')"
    if [[ -n "${hidden}" ]]; then
        bashio::log.warning "Chrome has windows (${hidden}) but none of them is visible."
        for candidate in ${hidden}; do
            xwininfo -id "${candidate}" -display "${DISPLAY}" 2>/dev/null \
                | grep -E 'Map State|Width|Height|Absolute upper-left' \
                | while read -r detail; do
                    bashio::log.warning "  ${candidate}: ${detail}"
                done
        done
        exit 0
    fi

    bashio::log.warning "No browser window appeared on ${DISPLAY} after 60s."
    bashio::log.warning "Windows currently mapped:"
    xwininfo -root -children -display "${DISPLAY}" 2>/dev/null \
        | sed -n '/children:/,$p' \
        | head -20 \
        | while read -r line; do
            [[ -n "${line}" ]] && bashio::log.warning "  ${line}"
        done
    exit 0
fi

bashio::log.info "Browser window ${window} found; sizing it to the display"
xdotool windowmove "${window}" 0 0 2>/dev/null
xdotool windowsize "${window}" 100% 100% 2>/dev/null
xdotool windowactivate "${window}" 2>/dev/null

# Report what the window actually is afterwards. A window that is mapped and
# full-screen but shows nothing is a painting problem, not a placement one,
# and those two need opposite fixes.
xwininfo -id "${window}" -display "${DISPLAY}" 2>/dev/null \
    | grep -E 'Absolute upper-left|Width|Height|Map State|xwininfo: Window id' \
    | while read -r line; do
        [[ -n "${line}" ]] && bashio::log.info "  ${line}"
    done

exit 0
