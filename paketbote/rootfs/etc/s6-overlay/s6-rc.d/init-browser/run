#!/command/with-contenv bashio
# ==============================================================================
# Prepares the persistent Chrome profile before the browser starts.
# ==============================================================================
declare profile="${CHROME_PROFILE}"
declare level
declare -A log_levels=(
    [off]=0 [fatal]=1 [error]=2 [warning]=3
    [notice]=4 [info]=5 [debug]=6 [trace]=7 [all]=8
)

# bashio reads its verbosity from $LOG_LEVEL and expects a number. Exporting it
# here would only affect this script, so publish it into the s6 container
# environment instead — every service started with `with-contenv` inherits it.
level="$(bashio::config 'log_level')"
printf '%s' "${log_levels[${level,,}]:-5}" > /run/s6/container_environment/LOG_LEVEL
bashio::log.level "${level}"

# The base image ships an empty /etc/machine-id, which Chrome complains about
# on every start. Keeping the generated id on the config volume also keeps the
# machine's identity stable across image rebuilds, not just restarts.
if [[ ! -s /etc/machine-id ]]; then
    if [[ ! -s /config/machine-id ]]; then
        dbus-uuidgen > /config/machine-id \
            || bashio::log.warning "Could not generate a machine id"
    fi
    cat /config/machine-id > /etc/machine-id || true
fi

mkdir -p "${profile}"

# A hard container stop leaves these behind, after which Chrome refuses to
# start and claims the profile is in use by another process.
rm -f \
    "${profile}/SingletonLock" \
    "${profile}/SingletonSocket" \
    "${profile}/SingletonCookie"

# Suppress the "Chrome didn't shut down correctly / Restore pages?" bubble,
# which would otherwise cover the page after every add-on restart.
if [[ -f "${profile}/Default/Preferences" ]]; then
    sed -i \
        -e 's/"exit_type":"[^"]*"/"exit_type":"Normal"/' \
        -e 's/"exited_cleanly":false/"exited_cleanly":true/' \
        "${profile}/Default/Preferences" || true
fi

bashio::log.info "Chrome profile ready at ${profile}"
