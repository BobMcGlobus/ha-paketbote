#!/command/with-contenv bashio
# ==============================================================================
# Virtual X server that backs the headful browser.
# ==============================================================================
declare -i width height

width=$(bashio::config 'display_width')
height=$(bashio::config 'display_height')

bashio::log.info "Starting Xvfb on ${DISPLAY} at ${width}x${height}..."

exec Xvfb "${DISPLAY}" \
    -screen 0 "${width}x${height}x24" \
    -nolisten tcp \
    -dpi 96 \
    -noreset \
    +extension RANDR
