#!/command/with-contenv bashio
# ==============================================================================
# Minimal window manager, so dialogs, MFA popups and file pickers are movable.
# ==============================================================================
bashio::log.debug "Waiting for X display ${DISPLAY}..."
until xdpyinfo -display "${DISPLAY}" > /dev/null 2>&1; do
    sleep 0.5
done

bashio::log.info "Starting Openbox..."

exec openbox
